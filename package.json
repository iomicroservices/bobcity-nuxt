{
  "name": "bobcity-nuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "deploy": "nuxt build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute bobcity --local --file=./server/database/schema.sql",
    "db:migrate:remote": "wrangler d1 execute bobcity --remote --file=./server/database/schema.sql",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@nuxt/content": "^3.16.1",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/turnstile": "^1.1.3",
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.5.2",
    "nuxt-studio": "^1.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261001.1": true,
    "vue-demi@0.14.10": true
  }
}
